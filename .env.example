# Copy to .env and fill in. .env is gitignored and must never be committed.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: paid fetch backend for JS-rendered / anti-bot sites.
# Leave FETCH_BACKEND=httpx for the offline demo path.
FETCH_BACKEND=httpx
CRAWLBASE_TOKEN=

# Paths (defaults are fine)
CACHE_DIR=.cache
DB_PATH=nimbus.db

# How old a cached page may be (seconds) before the crawler re-fetches it.
# 12 hours by default, so a nightly run always sees today's bytes; leave
# blank/unset for the default. `nimbus demo --offline` overrides this to
# "never expires" in code so its committed fixtures stay reproducible.
CACHE_MAX_AGE=43200
