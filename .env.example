# Copy to .env and fill in. .env is gitignored and must never be committed.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: paid fetch backend for JS-rendered / anti-bot sites.
# Leave FETCH_BACKEND=httpx for the offline demo path.
FETCH_BACKEND=httpx
CRAWLBASE_TOKEN=

# Paths (defaults are fine)
CACHE_DIR=.cache
DB_PATH=nimbus.db
